# ----- Copy this file to a new file named ".env" and fill in your values -----

# The port your backend server runs on
PORT=5000

# ----- MySQL database connection -----
# If you use XAMPP, the defaults are usually:
#   host = localhost, user = root, password = (empty), port = 3306
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Root@1234
DB_NAME=smart_grocery

# A long random secret used to sign login tokens. Type any random characters.
JWT_SECRET=change_this_to_a_long_random_string_12345
JWT_EXPIRES_IN=7d

# ----- AI recipe generator -----
# Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6IHKaohsq09hBJIBORIgDCw_uZSw7joF12UM7CNaR69jw